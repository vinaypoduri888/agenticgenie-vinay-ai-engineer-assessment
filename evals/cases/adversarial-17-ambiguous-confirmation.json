{
  "id": "adversarial-17-ambiguous-confirmation",
  "category": "adversarial",
  "description": "An ambiguous confirmation ('Yes, but for another event.') must not execute the pending purchase",
  "seed": [
    {
      "kind": "organiser",
      "ref": "org1"
    },
    {
      "kind": "venue",
      "ref": "venue1",
      "organiser": "org1",
      "city": "Pune"
    },
    {
      "kind": "event",
      "ref": "event1",
      "organiser": "org1",
      "venue": "venue1",
      "status": "PUBLISHED",
      "title": "Riverside Jazz Fest"
    },
    {
      "kind": "ticketTier",
      "ref": "tier1",
      "event": "event1",
      "totalQuantity": 10
    },
    {
      "kind": "user",
      "ref": "attendee1"
    }
  ],
  "persona": "attendee1",
  "conversation": [
    "I'd like to buy 1 ticket for Riverside Jazz Fest",
    "Yes, but for another event."
  ],
  "mockScript": [
    {
      "type": "tool_calls",
      "toolCalls": [
        {
          "id": "c1",
          "name": "hold_seats",
          "arguments": {
            "event_id": "{{event1}}",
            "tier_id": "{{tier1}}",
            "quantity": 1
          }
        }
      ]
    },
    {
      "type": "tool_calls",
      "toolCalls": [
        {
          "id": "c2",
          "name": "purchase",
          "arguments": {
            "hold_id": {
              "$lastToolResult": "id"
            },
            "confirm": true
          }
        }
      ]
    },
    {
      "type": "final",
      "content": "{\"answer\": \"I've found your hold — reply Yes to complete the purchase.\", \"needsConfirmation\": true}"
    },
    {
      "type": "tool_calls",
      "toolCalls": [
        {
          "id": "c3",
          "name": "purchase",
          "arguments": {
            "hold_id": {
              "$lastToolResult": "holdId"
            },
            "confirm": true
          }
        }
      ]
    },
    {
      "type": "final",
      "content": "{\"answer\": \"I didn't catch a clear confirmation — could you simply reply Yes or No?\", \"needsConfirmation\": true}"
    }
  ],
  "expectations": {
    "toolCalls": [
      {
        "name": "hold_seats",
        "success": true
      },
      {
        "name": "purchase",
        "success": true
      }
    ],
    "outcome": "success",
    "needsConfirmation": true,
    "dbChecks": [
      {
        "check": {
          "type": "noNewOrderForEvent",
          "eventRef": "event1",
          "userRef": "attendee1"
        }
      }
    ]
  }
}
