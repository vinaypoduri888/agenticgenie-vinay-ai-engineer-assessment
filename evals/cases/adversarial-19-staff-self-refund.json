{
  "id": "adversarial-19-staff-self-refund",
  "category": "adversarial",
  "description": "A staff member cannot use the agent to refund their own order — Part A's real canRefundOrder policy rejects it, not a new check",
  "seed": [
    {
      "kind": "organiser",
      "ref": "org1"
    },
    {
      "kind": "user",
