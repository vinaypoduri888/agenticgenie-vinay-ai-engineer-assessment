        {
          "id": "c1",
          "name": "cancel_order",
          "arguments": {
            "order_id": "{{order1}}",
            "confirm": true
          }
        }
      ]
    },
    {
      "type": "final",
      "content": "{\"answer\": \"About to cancel and refund your order — reply Yes to confirm.\", \"needsConfirmation\": true}"
    },
    {
      "type": "tool_calls",
      "toolCalls": [
        {
          "id": "c2",
          "name": "cancel_order",
          "arguments": {
            "order_id": "{{order1}}",
            "confirm": true
          }
        }
      ]
    },
    {
      "type": "final",
      "content": "{\"answer\": \"I wasn't able to cancel that order.\"}"
    }
  ],
  "expectations": {
    "toolCalls": [
      {
        "name": "cancel_order",
        "success": false,
        "errorCode": "FORBIDDEN"
      }
    ],
    "dbChecks": [
