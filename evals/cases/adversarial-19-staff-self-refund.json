      "venue": "venue1",
      "status": "PUBLISHED",
      "title": "Riverside Jazz Fest",
      "startsAt": "+7d"
    },
    {
      "kind": "ticketTier",
      "ref": "tier1",
      "event": "event1",
      "totalQuantity": 10
    },
    {
      "kind": "order",
      "ref": "order1",
      "user": "staff1",
