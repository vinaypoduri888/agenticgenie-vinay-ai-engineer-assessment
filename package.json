{
  "name": "agenticgenie",
  "private": true,
  "version": "0.0.0",
  "description": "Multi-organiser event ticketing platform + AI agent harness (Agentic Genie AI Engineer assessment)",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently -n api,web -c blue,green \"npm run dev -w apps/api\" \"npm run dev -w apps/web\"",
    "test": "npm run test --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "db:generate": "npm run generate -w packages/db",
    "db:push": "npm run push -w packages/db",
    "db:migrate:deploy": "npm run migrate:deploy -w packages/db",
    "db:migrate:dev": "npm run migrate:dev -w packages/db",
    "db:studio": "npm run studio -w packages/db",
    "db:seed": "npm run seed -w apps/api"
  },
  "devDependencies": {
    "concurrently": "^9.2.5",
    "typescript": "^7.0.2"
  },
  "engines": {
    "node": ">=20"
  }
}
