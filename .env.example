# Copy to .env at the repo root (used by apps/api and packages/db).
# Also copy apps/web/.env.example to apps/web/.env.local for the frontend.

# --- Database (PostgreSQL via Docker Compose) ---
DATABASE_URL="postgresql://agenticgenie:agenticgenie@localhost:5434/agenticgenie"

# --- Redis (background jobs — no jobs run yet; infra-only in Stage 1) ---
REDIS_URL="redis://localhost:6380"

# --- API ---
NODE_ENV=development
PORT=4000
CORS_ORIGIN="http://localhost:3000"

# --- Auth ---
# Generate your own, e.g.: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET="replace-with-a-random-64-char-secret-before-running-anything"
JWT_EXPIRES_IN="12h"
BCRYPT_SALT_ROUNDS=10

# --- AI providers (wired up in Part B; safe to leave unset for now) ---
# AI_PROVIDER=mock
# NEMOTRON_BASE_URL=
# NEMOTRON_API_KEY=
# NEMOTRON_MODEL=
